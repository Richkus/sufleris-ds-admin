{% import "partials/_icons.html.twig" as icons %}

<header class="topbar" x-data="{ profileOpen: false }">
    <a href="index.html" class="topbar__wordmark">
        <span class="topbar__wordmark-brand">Sufleris</span>
        <span class="topbar__wordmark-sub">DS.V.3</span>
    </a>

    <div class="topbar__actions">
        {#
            Experimental — lets us pace-check the alternate "V.2" shell
            (sidebar tint, no card/shadow around content, see Figma
            5638:14930) live across real pages instead of only in Figma,
            without maintaining a second copy of the site. Toggles a class
            on <html> (see the inline script in base.html.twig for the
            flash-of-wrong-shell prevention) persisted in localStorage by
            window.dsToggleShell (assets/js/app.js). Remove this button
            (and the shell-v2 styles) once we've decided either way.
        #}
        <button type="button" class="topbar__icon-btn" onclick="window.dsToggleShell()" title="V.2 layoutas">{{ icons.icon('layout', 20) }}</button>
        <a href="admin.html" class="topbar__icon-btn" title="MS Admin">{{ icons.icon('settings', 20) }}</a>
        <a href="https://www.mokesciu-sufleris.lt/" class="topbar__icon-btn" title="Mokesčių Sufleris">{{ icons.icon('home', 20) }}</a>

        <div class="topbar__profile-wrap">
            <button type="button" class="topbar__icon-btn" :class="{ 'is-active': profileOpen }" @click="profileOpen = !profileOpen" title="Profilis">
                {{ icons.icon('user-circle', 20) }}
            </button>

            {# Alpine's transition *modifier* shorthand (.opacity.scale.duration)
               generates the CSS itself — unlike the old longhand version here,
               which referenced "transition ease-out duration-150" as if those
               were real utility classes; Bootstrap doesn't define them, so
               that transition was silently a no-op (instant snap). #}
            <div x-show="profileOpen" x-cloak @click.outside="profileOpen = false"
                 x-transition.opacity.scale.95.duration.150ms>
                {% include "partials/_profile-dropdown.html.twig" %}
            </div>
        </div>
    </div>
</header>
