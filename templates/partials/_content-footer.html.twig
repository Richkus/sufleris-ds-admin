        <div class="content-footer__column">
            <div class="content-footer__heading">Planai</div>
            <a href="#">Kainos ir planai</a>
            <a href="#">Planas BAZINIS</a>
            <a href="#">Planas PRO</a>
            <a href="#">Planas KOMANDA</a>
            <a href="#">Papildomos prieigos</a>
            <a href="#">Planų palyginimas</a>
            <a href="#">Pasitarti su vadybininku</a>
        </div>
    </div>

    <div class="content-footer__bottom">
        <div class="content-footer__social">
            <a href="#" aria-label="Facebook">{{ icons.icon('facebook', 18) }}</a>
            <a href="#" aria-label="Instagram">{{ icons.icon('instagram', 18) }}</a>
            <a href="#" aria-label="LinkedIn">{{ icons.icon('linkedin', 18) }}</a>
            <span>Sekite mus socialiniuose tinkluose</span>
        </div>
        <div class="content-footer__copyright">Mokesčių SUFLERĮ kuria MERITS &copy; {{ "now"|date("Y") }}</div>
    </div>
</footer>
