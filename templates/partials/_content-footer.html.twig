{% import "partials/_icons.html.twig" as icons %}
{#
    Real-product mega-footer for the "Content concept" template — 4
    columns + a social/copyright bar. Unrelated to the DS-admin's own
    single-line _footer.html.twig (that one is a "this is a DS demo
    page" credit strip, this is real site navigation).
#}
<footer class="content-footer">
    <div class="content-footer__columns">
        <div class="content-footer__column">
            <div class="content-footer__heading">Apie mus</div>
            <a href="#" @click.prevent>Kaip veikia SUFLERIS?</a>
            <a href="#" @click.prevent>Kodėl tai darome?</a>
            <a href="#" @click.prevent>Mūsų komanda</a>
            <a href="#" @click.prevent>Atsiliepimai</a>
            <a href="#" @click.prevent>Taisyklės ir privatumas</a>

            <hr class="content-footer__divider">

            <div class="content-footer__heading">Susisiekti</div>
            <a href="#" @click.prevent>Pagalba prisijungiant</a>
            <a href="#" @click.prevent>Pagalba renkantis planą</a>
            <a href="#" @click.prevent>Kontaktai</a>
            <a href="#" @click.prevent>D.U.K</a>
        </div>

        <div class="content-footer__column">
            <div class="content-footer__heading">Turinys</div>
            <a href="#" @click.prevent>Šiandien SUFLERYJE</a>
            <a href="#" @click.prevent>Mokesčių naujienos</a>
            <a href="#" @click.prevent>Praktinės situacijos</a>
            <a href="#" @click.prevent>Sąvadai ir teminiai rinkiniai</a>
            <a href="#" @click.prevent>Seminarai ir vaizdo įrašai</a>
            <a href="#" @click.prevent>Renginių kalendorius</a>
            <a href="#" @click.prevent>Skaičiuoklės</a>
            <a href="#" @click.prevent>Specialus pagalbos rinkinys</a>
            <a href="#" @click.prevent>Pro mikroskopą <span class="badge-ds badge-ds--success">PRO</span></a>
            <a href="#" @click.prevent>Geroji praktika <span class="badge-ds badge-ds--success">PRO</span></a>
            <a href="#" @click.prevent>Pro komentarai <span class="badge-ds badge-ds--success">PRO</span></a>
            <a href="#" @click.prevent>Profilaktika <span class="badge-ds badge-ds--success">PRO</span></a>
        </div>

        <div class="content-footer__column">
            <div class="content-footer__heading">Mano sufleris</div>
            <a href="#" @click.prevent>Apie mano planą</a>
            <a href="#" @click.prevent>Mano pasižymėti</a>
            <a href="#" @click.prevent>Man atrakinti</a>
            <a href="#" @click.prevent>Man atsakyti</a>
            <a href="#" @click.prevent>Nustatymai</a>
            <a href="#" @click.prevent>Sąskaitos</a>
            <a href="#" @click.prevent>Užduoti savo klausimą</a>
        </div>

        <div class="content-footer__column">
            <div class="content-footer__heading">Planai</div>
            <a href="#" @click.prevent>Kainos ir planai</a>
            <a href="#" @click.prevent>Planas BAZINIS</a>
            <a href="#" @click.prevent>Planas PRO</a>
            <a href="#" @click.prevent>Planas KOMANDA</a>
            <a href="#" @click.prevent>Papildomos prieigos</a>
            <a href="#" @click.prevent>Planų palyginimas</a>
            <a href="#" @click.prevent>Pasitarti su vadybininku</a>
        </div>
    </div>

    <div class="content-footer__bottom">
        <div class="content-footer__social">
            <a href="#" @click.prevent aria-label="Facebook">{{ icons.icon('facebook', 18) }}</a>
            <a href="#" @click.prevent aria-label="Instagram">{{ icons.icon('instagram', 18) }}</a>
            <a href="#" @click.prevent aria-label="LinkedIn">{{ icons.icon('linkedin', 18) }}</a>
            <span>Sekite mus socialiniuose tinkluose</span>
        </div>
        <div class="content-footer__copyright">Mokesčių SUFLERĮ kuria MERITS &copy; {{ "now"|date("Y") }}</div>
    </div>
</footer>
