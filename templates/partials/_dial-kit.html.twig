{% import "partials/_icons.html.twig" as icons %}
{#
    A small always-on-screen "live controls" widget (fixed, bottom-right)
    — one place to hold whatever live-tunable parameters this prototype
    needs, rather than scattering each one into whatever chrome it
    happens to affect. That's what the layout switcher used to be: an
    icon in the topbar, awkwardly duplicated into the sidebar for V.2's
    topbar-less layout. This replaces both.

    Only one control group for now (Layoutas). Add more
    <div class="dial-kit__group"> blocks here as more live-tunable
    things come up — it's built to hold more, not just this one.

    Included once in base.html.twig (outside the isBare check, so it's
    available on admin.html too), not per-shell like the old switcher —
    it's fixed-positioned and independent of the topbar/sidebar chrome,
    so it doesn't need a shell-specific duplicate.
#}
<div class="dial-kit" x-data="{ open: false }">
    <div x-show="open" x-cloak @click.outside="open = false"
         x-transition.opacity.scale.95.duration.150ms class="dial-kit__panel">
        <div class="dial-kit__group">
            <div class="dial-kit__group-label">Layoutas</div>
            {% for version, label in { v1: 'V.1', v2: 'V.2', v3: 'V.3', v4: 'V.4 (dark)' } %}
                <button type="button" class="dial-kit__option" :class="{ 'is-active': $store.shell.current === '{{ version }}' }"
                        @click="window.dsSetShell('{{ version }}')">
                    <span>{{ label }}</span>
                    <span class="dial-kit__check" x-show="$store.shell.current === '{{ version }}'">{{ icons.icon('check', 14) }}</span>
                </button>
            {% endfor %}
        </div>

        <div class="dial-kit__divider"></div>

        {#
            Global "show code" switch — hides the per-component "Kodas"
            toggle + code panel everywhere (all pages/shells), not just
            collapses it. See window.dsSetShowCode / $store.devTools in
            app.js and the x-show bindings in buttons.html.twig.
        #}
        <div class="dial-kit__group">
            <div class="dial-kit__group-label">Kodas</div>
            <button type="button" class="dial-kit__toggle-row" @click="window.dsSetShowCode(!$store.devTools.showCode)">
                <span>Rodyti kodą</span>
                <span class="dial-kit__eye">
                    <span x-show="$store.devTools.showCode">{{ icons.icon('eye', 16) }}</span>
                    <span x-show="!$store.devTools.showCode" x-cloak>{{ icons.icon('eye-off', 16) }}</span>
                </span>
            </button>
        </div>
    </div>

    {# A playful emoji instead of a stroke-icon on purpose — this trigger
       opens a meta/dev-tools widget, not a real product surface, and the
       emoji signals that at a glance instead of blending in with the
       DS's own serious icon language. #}
    <button type="button" class="dial-kit__trigger" :class="{ 'is-active': open }" @click="open = !open"
            :data-tooltip="open ? false : 'Pareguliavimai :)'" aria-label="Pareguliavimai">
        <span class="dial-kit__trigger-emoji">🪄</span>
    </button>
</div>
