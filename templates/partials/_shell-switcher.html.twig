{% import "partials/_icons.html.twig" as icons %}
{#
    Experimental — lets us pace-check the alternate shell layouts (V.2:
    Figma 5638:14930, no topbar, sidebar/content as floating rounded
    cards; V.3: Figma 5644:845, topbar always visible) live across real
    pages instead of only in Figma, without maintaining separate copies
    of the site. Sets a class on <html> (see the inline script in
    base.html.twig for the flash-of-wrong-shell prevention) persisted in
    localStorage by window.dsSetShell (assets/js/app.js).

    Included twice (topbar + sidebar's V.2 bottom row, see
    _topbar.html.twig/_sidebar.html.twig) — V.2 hides the real topbar
    entirely, so it needs its own way to reach this switcher. Remove all
    of this (both includes, this file, the shell-v2/v3 styles) once
    we've settled on a layout.
#}
<div class="shell-switcher" x-data="{ open: false }">
    {# :data-tooltip (not a static attribute) so it's removed the instant
       the dropdown opens — otherwise the tooltip lingers behind/beside
       the open menu since the mouse never actually leaves the button. #}
    <button type="button" class="topbar__icon-btn" :class="{ 'is-active': open }" @click="open = !open" :data-tooltip="open ? false : 'Layoutas (V.1 / V.2 / V.3)'" aria-label="Layoutas (V.1 / V.2 / V.3)">
        {{ icons.icon('layers', 20) }}
    </button>

    <div x-show="open" x-cloak @click.outside="open = false"
         x-transition.opacity.scale.95.duration.150ms class="shell-switcher__menu">
        {% for version, label in { v1: 'V.1', v2: 'V.2', v3: 'V.3' } %}
            <button type="button" class="shell-switcher__option" :class="{ 'is-active': $store.shell.current === '{{ version }}' }"
                    @click="window.dsSetShell('{{ version }}'); open = false">
                <span>{{ label }}</span>
                <span class="shell-switcher__check" x-show="$store.shell.current === '{{ version }}'">{{ icons.icon('check', 16) }}</span>
            </button>
        {% endfor %}
    </div>
</div>
