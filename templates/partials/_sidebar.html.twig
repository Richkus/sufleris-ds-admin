{% import "partials/_icons.html.twig" as icons %}
{#
    Expects `currentPage` (string slug) in scope, set per-page in the page
    template's {% set currentPage = '...' %} before {% extends %} content is
    rendered (see any page template for the pattern).

    Flat grouped structure (Foundations / Components / Patterns /
    Pages · Templates), synced from Figma's current Nav/Sidebar master
    (node 5377:2, Design System page). The wordmark in the top bar is the
    only way back to Wellcome — it no longer has its own nav row.
#}
{% set sections = [
    {
        key: 'foundations',
        label: 'Foundations',
        items: [
            { label: 'Brand', slug: 'brand', href: 'brand.html' },
            { label: 'Colors', slug: 'colors', href: 'colors.html' },
            { label: 'Typography', disabled: true },
            { label: 'Spacing', disabled: true },
            { label: 'Icons', disabled: true },
        ],
    },
    {
        key: 'components',
        label: 'Components',
        items: [
            { label: 'Button', slug: 'buttons', href: 'buttons.html' },
            { label: 'Input', disabled: true },
            { label: 'Badge', disabled: true },
            { label: 'Dropdown', disabled: true },
            { label: 'Checkbox', disabled: true },
            { label: 'Radio button', disabled: true },
            { label: 'Tooltip', disabled: true },
            { label: 'Modal', disabled: true },
            { label: 'Feedback', disabled: true },
            { label: 'Tabs', slug: 'tabs', href: 'tabs.html' },
        ],
    },
    {
        key: 'patterns',
        label: 'Patterns',
        items: [
            { label: 'Content Card', disabled: true },
            { label: 'Search Result', disabled: true },
            { label: 'Search Bar', disabled: true },
            { label: 'Source Item', disabled: true },
            { label: 'Navigation Item', disabled: true },
            { label: 'Filter Group', disabled: true },
            { label: 'Content Item Header', disabled: true },
            { label: 'Similar Content', disabled: true },
            { label: 'User Actions', disabled: true },
            { label: 'Table of Contents', disabled: true },
            { label: 'Slider / Carousel', disabled: true },
        ],
    },
    {
        key: 'pages',
        label: 'Pages / Templates',
        items: [
            { label: 'Search', disabled: true },
            { label: 'Home', disabled: true },
            { label: 'Content detail', disabled: true },
            { label: 'Test / Quiz', disabled: true },
            { label: 'etc.', disabled: true },
        ],
    },
] %}

<nav class="sidebar">
    {#
        Only shown in the experimental "V.2" shell (html.shell-v2, see
        _topbar.html.twig/app.js) — that variant hides the real topbar
        entirely and relocates the wordmark + icon actions here, matching
        Figma 5638:14930. Duplicated (not moved) so the default (V.1)
        shell is untouched; hidden via CSS the rest of the time.
    #}
    <div class="sidebar__v2-header">
        <a href="index.html" class="topbar__wordmark">
            <span class="topbar__wordmark-brand">Sufleris</span>
            <span class="topbar__wordmark-sub">DS.V.3</span>
        </a>
    </div>

    {#
        dsSidebarState() (assets/js/app.js) persists expand/collapse per
        section in localStorage — all expanded on a first visit, then
        whatever the user last left open/closed sticks on later visits
        instead of resetting every page load.
    #}
    <div class="sidebar__nav" x-data="dsSidebarState()">
        {% for section in sections %}
            <div class="sidebar__section">
                <button type="button" class="sidebar__section-header" @click="toggleSection('{{ section.key }}')" :aria-expanded="open.{{ section.key }}.toString()">
                    <span>{{ section.label }}</span>
                    <span class="sidebar__chevron" :class="{ 'is-collapsed': !open.{{ section.key }} }">{{ icons.chevronSm() }}</span>
                </button>
                <div class="sidebar__section-items" x-show="open.{{ section.key }}" x-collapse.duration.150ms>
                    {% for item in section.items %}
                        {% if item.disabled %}
                            <span class="sidebar__item is-disabled">{{ item.label }}</span>
                        {% else %}
                            <a href="{{ item.href }}" class="sidebar__item {{ currentPage == item.slug ? 'is-active' }}">{{ item.label }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="sidebar__v2-actions" x-data="{ profileOpen: false }">
        <a href="admin.html" class="topbar__icon-btn" data-tooltip="MS Admin" aria-label="MS Admin">{{ icons.icon('dashboard', 20) }}</a>
        <a href="https://www.mokesciu-sufleris.lt/" target="_blank" rel="noopener noreferrer" class="topbar__icon-btn topbar__icon-btn--badged" data-tooltip="Mokesčių Sufleris (naujame lange)" aria-label="Mokesčių Sufleris (atsidaro naujame lange)">
            {{ icons.icon('home', 20) }}
            <span class="topbar__icon-btn__badge">{{ icons.icon('arrow-up-right', 8) }}</span>
        </a>
        <div class="topbar__profile-wrap">
            <button type="button" class="topbar__icon-btn" :class="{ 'is-active': profileOpen }" @click="profileOpen = !profileOpen" :data-tooltip="profileOpen ? false : 'Profilis'" aria-label="Profilis">
                {{ icons.icon('user-circle', 20) }}
            </button>
            <div x-show="profileOpen" x-cloak @click.outside="profileOpen = false"
                 x-transition.opacity.scale.95.duration.150ms>
                {% include "partials/_profile-dropdown.html.twig" %}
            </div>
        </div>
    </div>
</nav>
