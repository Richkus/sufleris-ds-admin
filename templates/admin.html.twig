{% set currentPage = 'admin' %}
{% set bare = true %}
{% extends "base.html.twig" %}
{% import "partials/_icons.html.twig" as icons %}

{% block title %}MS Admin — {{ parent() }}{% endblock %}

{% block content %}
    <div class="admin-placeholder">
        <div class="admin-placeholder__icon">{{ icons.icon('dashboard', 48) }}</div>
        <h3 class="admin-placeholder__title">Tai MS Admin dalis</h3>
        <p class="admin-placeholder__subtitle">Atsidarys admin MS dalis, kuri nepriklauso dizaino sistemai.</p>
        <button type="button" class="btn-ds btn-ds--secondary" onclick="window.history.length > 1 ? window.history.back() : (window.location.href = 'index.html')">
            Uždaryti
        </button>
    </div>
{% endblock %}
