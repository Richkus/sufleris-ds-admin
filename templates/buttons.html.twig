        title: 'Buttons',
        subtitle: 'Mygtukai suaktyvina vieną veiksmą arba naršymo įvykį, o spalva ir šrifto svoris nurodo prioritetą — rinkitės Pirminį (Primary) svarbiausiam ekrano veiksmui, Antrinį (Secondary) papildomiems veiksmams, Naikinantį (Destructive) veiksmams, kurie ištrina ar pašalina duomenis, ir Nuorodą (Link) mažo akcento veiksmams tekste.',
    } %}

    <section class="ds-section">
        <h2 class="ds-section__title">Variants &amp; States</h2>

        {# Primary — the only variant with the real "Show code" interaction. #}
        <div class="ds-group" x-data="{
                expanded: false,
                copied: false,
                code: '{{ ('' ~ _self.buttonCode('primary'))|e('js') }}',
                copyCode() {
                    navigator.clipboard.writeText(this.code).catch(() => {});
                    this.copied = true;
                    setTimeout(() => { this.copied = false; }, 2200);
                }
            }">
            <div class="ds-group__label">Primary</div>
            <div class="ds-group__row">
                {{ _self.stateButton('primary', 'Primary') }}
                <button type="button" class="show-code-toggle" x-show="$store.devTools.showCode"
                        @click="expanded = !expanded; if (expanded) $nextTick(() => Prism.highlightAllUnder($el.closest('.ds-group')))">
                    <span x-show="!expanded" x-transition.opacity.duration.150ms>{{ icons.icon('code', 16) }} Kodas</span>
                    <span x-show="expanded" x-transition.opacity.duration.150ms x-cloak>{{ icons.icon('x', 16) }}</span>
                </button>
            </div>

            <div class="code-panel" x-show="expanded && $store.devTools.showCode" x-collapse x-cloak>
                <div class="code-panel__header">
                    <button type="button" class="code-panel__copy" @click="copyCode()" :title="copied ? 'Nukopijuota' : 'Kopijuoti kodą'">
                        <span x-show="!copied" x-transition.opacity.duration.150ms>{{ icons.icon('copy', 14) }}</span>
                        <span x-show="copied" x-transition.opacity.duration.150ms x-cloak>{{ icons.icon('check', 14) }}</span>
                    </button>
                </div>
                <div class="code-panel__body">
