                copied: false,
                code: '&lt;button class=&quot;btn btn-primary&quot;&gt;Default&lt;/button&gt;\n&lt;button class=&quot;btn btn-primary&quot; disabled&gt;Disabled&lt;/button&gt;\n&lt;button class=&quot;btn btn-primary btn-loading&quot;&gt;\n  &lt;span class=&quot;spinner&quot;&gt;&lt;/span&gt; Loading\n&lt;/button&gt;',
                copyCode() {
                    navigator.clipboard.writeText(this.code).catch(() => {});
                    this.copied = true;
                    setTimeout(() => { this.copied = false; }, 2200);
                }
            }">
            <div class="ds-group__label">Primary</div>
            <div class="ds-group__row">{{ _self.stateButton('primary', 'Primary') }}</div>

            <div class="btn-demo__toggle-row">
                <button type="button" class="show-code-toggle"
                        @click="expanded = !expanded; if (expanded) $nextTick(() => Prism.highlightAllUnder($el.closest('.ds-group')))">
                    <span x-show="!expanded" x-transition.opacity.duration.150ms>{{ icons.icon('code', 16) }} Rodyti kodą</span>
                    <span x-show="expanded" x-transition.opacity.duration.150ms x-cloak>{{ icons.icon('x', 16) }} Uždaryti</span>
                </button>
            </div>

            <div class="code-panel" x-show="expanded" x-collapse x-cloak>
