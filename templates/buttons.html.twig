{% set currentPage = 'buttons' %}
{% extends "base.html.twig" %}
{% import "partials/_icons.html.twig" as icons %}

{% block title %}Buttons — {{ parent() }}{% endblock %}

{% macro stateButton(variant, label) %}
    {% set cls = 'btn-ds btn-ds--' ~ variant %}
    <button type="button" class="{{ cls }}">Default</button>
    <button type="button" class="{{ cls }} is-hover">Hover</button>
    <button type="button" class="{{ cls }} is-disabled" disabled>Disabled</button>
    <button type="button" class="{{ cls }} is-loading">{{ _self.spinner() }} Loading</button>
{% endmacro %}

{% macro spinner() %}
    <svg class="btn-ds__spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
{% endmacro %}

{#
    Single source of truth for the "Show code" samples below — built from
    the SAME class pattern (and the SAME spinner markup, via _self.spinner())
    that stateButton() actually renders above. Previously each of the 6
    groups hand-typed its own generic Bootstrap-ish sample ("btn btn-primary",
    "btn-outline-danger", <span class="spinner">...) that didn't match the
    real btn-ds/btn-ds--variant markup at all, and drifted further out of
    sync every time the component changed. Callers apply |e for the
    HTML-escaped <pre><code> display and |e('js') for the Alpine `code:`
    clipboard string — see the two call sites per group below.
#}
{% macro buttonCode(variant) %}<button type="button" class="btn-ds btn-ds--{{ variant }}">Default</button>
<button type="button" class="btn-ds btn-ds--{{ variant }} is-disabled" disabled>Disabled</button>
<button type="button" class="btn-ds btn-ds--{{ variant }} is-loading">
  {{ _self.spinner() }} Loading
</button>{% endmacro %}

{% block content %}
